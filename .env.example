# LifeLink 2 – Konfiguration für docker compose
# Kopieren nach .env und Werte setzen. Die .env niemals in Git committen.

# Passwort der LifeLink-Datenbank (lang und zufällig, z. B. 32 Zeichen)
POSTGRES_PASSWORD=bitte-ersetzen

# Master-Schlüssel: verschlüsselt alle gespeicherten Zugangsdaten und Sicherungen.
# Erzeugen:  docker compose run --rm --no-deps lifelink node server/dist/cli.js gen-master-key
# WICHTIG: Getrennt von den Sicherungen aufbewahren (Passwort-Manager). Ohne ihn sind
# Zugangsdaten und Sicherungen nicht mehr lesbar; ändern macht gespeicherte Geheimnisse unbrauchbar.
LIFELINK_MASTER_KEY=

# Öffentliche Adresse, unter der LifeLink erreichbar ist (für Webhook-Adressen und Einladungslinks)
PUBLIC_URL=https://lifelink.example.de

# Port auf dem Server und Netzwerkschnittstelle (0.0.0.0 = alle, 127.0.0.1 = nur lokal/Proxy)
LIFELINK_PORT=7310
LIFELINK_BIND=0.0.0.0

# Läuft ein TLS-Reverse-Proxy (Nginx, Caddy, Traefik …) davor? Dann true, damit die echte Client-IP
# für Sperren und Audit genutzt wird. Ohne Proxy: false.
TRUST_PROXY=true

# Sitzungs-Cookies nur über HTTPS senden. Nur auf false setzen, wenn LifeLink ausschließlich
# im geschützten internen Netz ohne TLS betrieben wird (nicht empfohlen).
COOKIE_SECURE=true

# Gleichzeitige Ausführungen pro Worker (Feinsteuerung zusätzlich in den Einstellungen)
WORKER_CONCURRENCY=4

# Optional: anderes Repository für Updates (Standard thisislennard/LifeLink)
# UPDATE_REPOSITORY=thisislennard/LifeLink
