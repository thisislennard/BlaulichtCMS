# LifeLink – Beispielkonfiguration für docker compose (alle Werte optional).
# Kopieren nach .env. Die .env niemals in Git committen.

# Port auf dem Docker-Host und Netzwerkschnittstelle.
# Hinter einem Reverse Proxy auf demselben Host: LIFELINK_BIND=127.0.0.1
LIFELINK_PORT=7310
# Versioniertes Image (Update: scripts/update.sh <image>)
# LIFELINK_IMAGE=lifelink:local
LIFELINK_BIND=0.0.0.0

# Läuft ein HTTPS-Reverse-Proxy davor? Dann true (echte Client-IP für Sperren und Audit).
TRUST_PROXY=false

# Sitzungs-Cookies nur über HTTPS senden. Für einen ersten lokalen Test ohne HTTPS auf false setzen.
COOKIE_SECURE=false

# Öffentliche Adresse – wird im Erstsetup festgelegt. Hier nur als Vorschlag für den Assistenten.
# PUBLIC_URL=https://lifelink.example.org

# Master-Schlüssel (32 Byte, Base64). Ohne Angabe erzeugt LifeLink beim ersten Start
# /data/secrets/master.key. Wer ihn außerhalb des Volumes verwalten will, setzt ihn hier:
#   docker run --rm lifelink:local node server/dist/cli.js gen-master-key
# LIFELINK_MASTER_KEY=
