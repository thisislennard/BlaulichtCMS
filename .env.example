# BlaulichtCMS – Beispielkonfiguration für docker compose. Kopieren nach .env (install.sh erledigt das).
# Die .env niemals in Git committen.

# Öffentliche HTTPS-Adresse (wie im Reverse Proxy eingerichtet). Steht in Einladungen, Upload-Links und QR-Codes.
# Wird im Erstsetup festgelegt – hier nur als Vorschlag für den Assistenten.
# PUBLIC_URL=https://blaulichtcms.example.org

# Port am Docker-Host und Netzwerkschnittstelle.
# 127.0.0.1 = nur lokal (Reverse Proxy auf demselben Host oder als Container im Netz proxy-net).
# Proxy auf einem anderen Host (z. B. IIS): LAN-Adresse eintragen und Port per Firewall nur für den Proxy freigeben.
BLAULICHTCMS_BIND=127.0.0.1
BLAULICHTCMS_PORT=7310

# Gemeinsames Docker-Netz mit dem Reverse-Proxy-Container. Ziel im Proxy: blaulichtcms:7310
BLAULICHTCMS_PROXY_NETWORK=proxy-net

# Adressen des Reverse Proxys, denen BlaulichtCMS die Client-IP aus X-Forwarded-For glaubt (Sperren, Rate-Limits, Audit).
# Liste aus IPs/Netzen (z. B. 172.18.0.0/16 = Netz proxy-net, 192.168.1.20 = IIS-Server) oder die Wörter
# loopback, linklocal, uniquelocal, private (= alle privaten Bereiche). Leer = Header ignorieren (kein Proxy).
# Je enger, desto besser: „private“ glaubt auch anderen Containern im selben Netz. Ermitteln z. B. mit
#   docker network inspect proxy-net -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# (TRUST_PROXY=true aus älteren Versionen wirkt wie TRUSTED_PROXIES=private und erzeugt beim Start eine Warnung.)
TRUSTED_PROXIES=private

# Sitzungs-Cookies nur über HTTPS senden. Nur für einen ersten lokalen Test ohne HTTPS auf false setzen.
COOKIE_SECURE=true
# Audit zusätzlich an eine zentrale Protokollierung (docs/betrieb.md, „Audit-Protokoll“): stdout oder syslog
# AUDIT_FORWARD=
# AUDIT_SYSLOG_HOST=192.0.2.10
# AUDIT_SYSLOG_PORT=514
# AUDIT_SYSLOG_PROTOCOL=udp

# Optionale Schadsoftwareprüfung der Uploads mit ClamAV (docs/betrieb.md, „Schadsoftwareprüfung“):
# COMPOSE_PROFILES=clamav
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=120000

# HSTS (nur mit COOKIE_SECURE=true): Standard ein Jahr, ohne Subdomains und ohne preload.
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=false
# HSTS_PRELOAD=false

# Versioniertes Image (Update: ./install.sh bzw. scripts/update.sh <image>)
BLAULICHTCMS_IMAGE=blaulichtcms:local

# Grenzen für den Container
BLAULICHTCMS_MEM_LIMIT=4g
BLAULICHTCMS_PIDS_LIMIT=512
# CPU-Kerne für den Container (Standard 2, höchstens so viele wie der Host hat)
# BLAULICHTCMS_CPUS=2

# Master-Schlüssel (32 Byte, Base64). Ohne Angabe erzeugt BlaulichtCMS beim ersten Start
# /data/secrets/master.key im Volume (er ist dann in jeder Volume-Sicherung enthalten – dort nur verschlüsselt mit
# dem Sicherungsschlüssel /etc/blaulichtcms/backup.key am Host, siehe docs/betrieb.md).
# Wer ihn außerhalb des Volumes verwalten will:
#   docker run --rm blaulichtcms:local node server/dist/cli.js gen-master-key
# BLAULICHTCMS_MASTER_KEY=
