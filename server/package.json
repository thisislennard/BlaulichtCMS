    "@fastify/static": "^10.1.8",
    "@node-rs/argon2": "^2.2.2",
    "@types/yazl": "^3.3.1",
    "adm-zip": "^0.6.1",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.7",
    "file-type": "^22.3.0",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
